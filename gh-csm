#!/usr/bin/env bash
#
# gh-csm — GitHub Codespaces quota dashboard & manager (gh extension).
#
# Requires: bash 3.2+, gh, jq. See README.md and SPEC.md.
#
# Why the code looks conservative: macOS ships /bin/bash 3.2.57, so no
# associative arrays, no mapfile/readarray, no ${var,,}, no &>>.

# LC_ALL=C：gawk 在逗號小數 locale（如 de_DE）會讓 printf "%.2f" 印出 "51,98"；C locale 只固定 awk 數值格式化的小數點。面板的 █ · ─ — 是腳本內字面值，LC_ALL 不影響其透傳輸出。
export LC_ALL=C

set -euo pipefail

VERSION="1.0.0"
BAR_WIDTH=20
COMPUTE_LIMIT="${GH_CSM_COMPUTE_LIMIT:-120}"
STORAGE_LIMIT="${GH_CSM_STORAGE_LIMIT:-15}"

AUTH_JSON=""
BILL_YM=""
BILL_YEAR=""
BILL_MONTH=""

# codespace 內建的 GITHUB_TOKEN 優先序高於 gh 的登入憑證，會讓所有查詢變成
# 別的 token 身分（常見症狀：403 或「沒有 active 帳號」）。本工具一律以 gh
# 登入的帳號為準，所以在自己的 process 內丟掉它。
GH_CSM_IGNORED_TOKEN=0
if [ -n "${GITHUB_TOKEN:-}" ]; then
  unset GITHUB_TOKEN
  GH_CSM_IGNORED_TOKEN=1
fi

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_RESET=$'\033[0m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_RED=$'\033[31m'
  C_BOLD=$'\033[1m'
else
  C_RESET=""
  C_GREEN=""
  C_YELLOW=""
  C_RED=""
  C_BOLD=""
fi

case "$(uname -s)" in
  Darwin|FreeBSD|OpenBSD|NetBSD) DATE_STYLE="bsd" ;;
  *) DATE_STYLE="gnu" ;;
esac

usage() {
  cat <<'EOF'
gh-csm — GitHub Codespaces quota dashboard & manager

Usage:
  gh csm quota [--account <login> | --all]
  gh csm stop [-c <name>] [--account <login>]
  gh csm start [-c <name>] [snippet] [--account <login>]
  gh csm selftest
  gh csm help

Commands:
  quota       Quota panel: compute / storage usage and reset countdown
  stop        Stop a codespace (interactive picker without -c)
  start       Wake a codespace and run a snippet; omit snippet for an interactive shell
  selftest    Offline fixture self-test (no network)

Account:
  Defaults to the gh active account.
  --account <login>   Use a signed-in account (also --account=<login>)
  --all               Every signed-in account, panels stacked (quota only)

Quota limits (GitHub Free defaults):
  GH_CSM_COMPUTE_LIMIT=120   core-hours / month
  GH_CSM_STORAGE_LIMIT=15    GB-month / month
  Pro accounts: GH_CSM_COMPUTE_LIMIT=180 GH_CSM_STORAGE_LIMIT=20 gh csm quota

Requirements:
  gh (signed in with gh auth login; needs user and codespace scopes), jq
  Missing scope unlock: gh auth switch --user <login> && gh auth refresh -h github.com -s user,codespace

Examples:
  gh csm quota
  gh csm quota --all
  gh csm stop
  gh csm start
  gh csm start -c my-codespace 'echo gogogo...'
EOF
}

die() {
  printf 'gh-csm: %s\n' "$*" >&2
  exit 1
}

warn() {
  printf 'gh-csm: %s\n' "$*" >&2
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing $1, install it first"
}

# ---------- 數值（bash 3.2 沒有浮點，交給 awk） ----------

fdiv() { awk -v a="$1" -v b="$2" 'BEGIN { printf "%.10f\n", a / b }'; }
fgt() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a > b) }'; }
fclose() { awk -v a="$1" -v b="$2" -v t="$3" 'BEGIN { d = a - b; if (d < 0) d = -d; exit !(d <= t) }'; }
fmt2() { awk -v a="$1" 'BEGIN { printf "%.2f", a }'; }
fmt4() { awk -v a="$1" 'BEGIN { printf "%.4f", a }'; }

pct() {
  awk -v used="$1" -v limit="$2" 'BEGIN {
    if (limit <= 0) { print 0; exit }
    printf "%d\n", (used / limit) * 100
  }'
}

# 剩餘可跑時數：整數、向下取整（不虛報）。
remaining_hours() {
  awk -v used="$1" -v limit="$2" -v cores="$3" 'BEGIN {
    left = limit - used
    if (left < 0) left = 0
    printf "%d\n", left / cores
  }'
}

is_positive_number() {
  awk -v v="$1" 'BEGIN { exit !(v ~ /^[0-9]+([.][0-9]+)?$/ && v + 0 > 0) }'
}

validate_limits() {
  is_positive_number "$COMPUTE_LIMIT" || die "GH_CSM_COMPUTE_LIMIT must be a positive number (currently: ${COMPUTE_LIMIT})"
  is_positive_number "$STORAGE_LIMIT" || die "GH_CSM_STORAGE_LIMIT must be a positive number (currently: ${STORAGE_LIMIT})"
}

# ---------- 領域邏輯 ----------

# SKU 是人類可讀字串（"Codespaces compute 4-core"），不可硬編 d2/d4 這類 id。
sku_cores() {
  local sku="$1" n
  case "$sku" in
    "Codespaces compute "[0-9]*-core)
      n="${sku#Codespaces compute }"
      n="${n%-core}"
      printf '%s\n' "$n"
      return 0
      ;;
  esac
  return 1
}

days_in_month() {
  local y="$1" m="$2"
  case "$m" in
    1|3|5|7|8|10|12) printf '31\n' ;;
    4|6|9|11) printf '30\n' ;;
    2)
      if [ $((y % 4)) -eq 0 ] && { [ $((y % 100)) -ne 0 ] || [ $((y % 400)) -eq 0 ]; }; then
        printf '29\n'
      else
        printf '28\n'
      fi
      ;;
    *) return 1 ;;
  esac
}

month_hours() {
  local days
  days=$(days_in_month "$1" "$2") || return 1
  printf '%s\n' $((days * 24))
}

color_for() {
  local p="$1"
  if [ "$p" -ge 90 ]; then
    printf 'red'
  elif [ "$p" -ge 70 ]; then
    printf 'yellow'
  else
    printf 'green'
  fi
}

color_code() {
  case "$1" in
    green) printf '%s' "$C_GREEN" ;;
    yellow) printf '%s' "$C_YELLOW" ;;
    red) printf '%s' "$C_RED" ;;
    *) printf '%s' "$C_RESET" ;;
  esac
}

bar() {
  local p="$1" filled i out
  filled=$((p * BAR_WIDTH / 100))
  if [ "$filled" -gt "$BAR_WIDTH" ]; then filled=$BAR_WIDTH; fi
  if [ "$filled" -lt 0 ]; then filled=0; fi
  out=""
  i=0
  while [ "$i" -lt "$filled" ]; do
    out="${out}█"
    i=$((i + 1))
  done
  while [ "$i" -lt "$BAR_WIDTH" ]; do
    out="${out}░"
    i=$((i + 1))
  done
  printf '%s' "$out"
}

# RFC3339（含 Z 或 ±HH:MM）→ epoch 秒，純算術、跨平台。
epoch_from_iso() {
  awk -v ts="$1" 'BEGIN {
    s = ts
    off = 0
    if (match(s, /[+-][0-9][0-9]:[0-9][0-9]$/)) {
      sign = substr(s, RSTART, 1)
      hh = substr(s, RSTART + 1, 2) + 0
      mm = substr(s, RSTART + 4, 2) + 0
      off = hh * 3600 + mm * 60
      if (sign == "-") off = -off
      s = substr(s, 1, RSTART - 1)
    }
    sub(/Z$/, "", s)
    if (s !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]$/) exit 1
    y = substr(s, 1, 4) + 0
    mo = substr(s, 6, 2) + 0
    d = substr(s, 9, 2) + 0
    h = substr(s, 12, 2) + 0
    mi = substr(s, 15, 2) + 0
    se = substr(s, 18, 2) + 0
    yy = y
    if (mo <= 2) yy = yy - 1
    era = int(yy / 400)
    yoe = yy - era * 400
    doy = int((153 * (mo + (mo > 2 ? -3 : 9)) + 2) / 5) + d - 1
    doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy
    printf "%d\n", (era * 146097 + doe - 719468) * 86400 + h * 3600 + mi * 60 + se - off
    exit 0
  }'
}

local_time() {
  local ts="$1" epoch
  case "$ts" in
    ""|null) printf '-' ; return 0 ;;
  esac
  if ! epoch=$(epoch_from_iso "$ts"); then
    printf '%s' "$ts"
    return 0
  fi
  if [ "$DATE_STYLE" = "bsd" ]; then
    date -r "$epoch" '+%Y-%m-%d %H:%M' 2>/dev/null || printf '%s' "$ts"
  else
    date -d "@$epoch" '+%Y-%m-%d %H:%M' 2>/dev/null || printf '%s' "$ts"
  fi
}

# 距離下一個 UTC 月初 00:00（額度重置點）的剩餘時間。now 為 epoch 秒，
# 年月對應計費月；12 月要跨到隔年 1 月。
reset_countdown() {
  local now="$1" year="$2" month="$3" ny nm next left
  ny="$year"
  nm=$((month + 1))
  if [ "$nm" -gt 12 ]; then
    nm=1
    ny=$((year + 1))
  fi
  next=$(epoch_from_iso "$(printf '%04d-%02d-01T00:00:00Z' "$ny" "$nm")") || {
    printf '?\n'
    return 0
  }
  left=$((next - now))
  if [ "$left" -lt 0 ]; then left=0; fi
  if [ "$left" -ge 86400 ]; then
    printf '%dd%dh\n' $((left / 86400)) $(( (left % 86400) / 3600 ))
  elif [ "$left" -ge 3600 ]; then
    printf '%dh\n' $((left / 3600))
  else
    printf '%dm\n' $((left / 60))
  fi
}

set_billing_period() {
  BILL_YM=$(date -u '+%Y-%m')
  BILL_YEAR="${BILL_YM%-*}"
  BILL_MONTH="${BILL_YM#*-}"
  BILL_MONTH="${BILL_MONTH#0}"
}

# ---------- gh 存取（token 只經環境變數傳遞） ----------

load_auth() {
  if [ -n "$AUTH_JSON" ]; then
    return 0
  fi
  need_cmd gh
  need_cmd jq
  if [ "$GH_CSM_IGNORED_TOKEN" -eq 1 ]; then
    warn "ignoring GITHUB_TOKEN env var (it shadows gh login, common inside codespaces) — inside a codespace? run gh auth login once"
  fi
  if ! AUTH_JSON=$(gh auth status --json hosts 2>/dev/null); then
    die "gh is not signed in, or gh is too old (2.40+ required). Run: gh auth login"
  fi
  if [ -z "$AUTH_JSON" ]; then
    die "could not read gh auth status. Run: gh auth login"
  fi
}

list_accounts() {
  printf '%s' "$AUTH_JSON" | jq -r '.hosts["github.com"][]? | .login'
}

accounts_inline() {
  list_accounts | awk 'NR > 1 { printf " " } { printf "%s", $0 }'
}

active_account() {
  printf '%s' "$AUTH_JSON" | jq -r '[.hosts["github.com"][]? | select(.active == true)] | .[0].login // empty'
}

account_scopes() {
  printf '%s' "$AUTH_JSON" | jq -r --arg login "$1" '.hosts["github.com"][]? | select(.login == $login) | .scopes // ""'
}

account_is_active() {
  local v
  v=$(printf '%s' "$AUTH_JSON" | jq -r --arg login "$1" '.hosts["github.com"][]? | select(.login == $login) | .active')
  if [ "$v" = "true" ]; then
    printf 'yes'
  else
    printf 'no'
  fi
}

has_scope() {
  case ",${1// /}," in
    *",$2,"*) return 0 ;;
    *) return 1 ;;
  esac
}

require_scope() {
  local scopes
  scopes=$(account_scopes "$1")
  if has_scope "$scopes" "$2"; then
    return 0
  fi
  die "account $1 is missing the $2 scope. Unlock: gh auth switch --user $1 && gh auth refresh -h github.com -s user,codespace"
}

# GITHUB_TOKEN（codespace 內建）優先序高於 GH_TOKEN，會蓋掉登入身分 → 明確移除。
gh_as() {
  local login="$1"
  shift
  local tok
  if ! tok=$(gh auth token --user "$login" 2>/dev/null); then
    die "could not get a token for $login. Run: gh auth login"
  fi
  env -u GITHUB_TOKEN GH_TOKEN="$tok" gh "$@"
}

resolve_login() {
  local login
  if [ "$ALL" -eq 1 ]; then
    die "--all does not apply to this subcommand"
  fi
  if [ -n "$ACCOUNT" ]; then
    if ! list_accounts | grep -qxF -- "$ACCOUNT"; then
      die "no signed-in account ${ACCOUNT} (signed in: $(accounts_inline))"
    fi
    printf '%s\n' "$ACCOUNT"
    return 0
  fi
  login=$(active_account)
  if [ -z "$login" ]; then
    die "no active account, pass --account <login>"
  fi
  printf '%s\n' "$login"
}

selected_accounts() {
  if [ "$ALL" -eq 1 ]; then
    list_accounts
  else
    resolve_login
  fi
}

# ---------- billing ----------

fetch_usage() {
  local login="$1" out
  if ! out=$(gh_as "$login" api "/users/$login/settings/billing/usage?year=$BILL_YEAR&month=$BILL_MONTH" 2>&1); then
    warn "failed to read billing for $login: $(printf '%s' "$out" | head -n 1) (missing user scope / network error / unknown account)"
    return 1
  fi
  if ! printf '%s' "$out" | jq -e '.usageItems' >/dev/null 2>&1; then
    warn "$login billing response was not the expected JSON (proxy or HTML interception?)"
    return 1
  fi
  printf '%s\n' "$out"
}

sum_compute() {
  awk -F'\t' '{ total += $1 * $2 } END { printf "%.10f\n", total }'
}

sum_quantity() {
  awk '{ total += $1 } END { printf "%.10f\n", total }'
}

# 用量一律用 quantity（machine-hours / GigabyteHours），不用金額欄位。
summarize_usage() {
  local json="$1" rows sku qty cores compute_tsv storage_tsv
  rows=$(printf '%s' "$json" | jq -r '.usageItems[]? | select(.product == "codespaces") | [.sku, .quantity] | @tsv')
  compute_tsv=""
  storage_tsv=""
  while IFS=$'\t' read -r sku qty; do
    if [ -z "$sku" ]; then
      continue
    fi
    if [ "$sku" = "Codespaces storage" ]; then
      storage_tsv="$storage_tsv$qty"$'\n'
      continue
    fi
    if cores=$(sku_cores "$sku"); then
      compute_tsv="$compute_tsv$cores"$'\t'"$qty"$'\n'
    else
      warn "unknown SKU \"${sku}\" skipped (cannot determine cores, not counted toward quota)"
    fi
  done <<< "$rows"
  printf '%s %s\n' "$(printf '%s' "$compute_tsv" | sum_compute)" "$(printf '%s' "$storage_tsv" | sum_quantity)"
}

fetch_codespaces() {
  local login="$1" out
  if ! out=$(gh_as "$login" api "/user/codespaces?per_page=100" 2>&1); then
    warn "failed to read the codespace list for $login: $(printf '%s' "$out" | head -n 1)"
    return 1
  fi
  printf '%s' "$out" | jq -r '.codespaces[]? | [.name, .state, ((.machine.cpus // 0) | tostring), (.last_used_at // ""), (.repository.full_name // "")] | @tsv'
}

# ---------- 面板 ----------

print_panel_head() {
  local login="$1" active="$2" show_flag="$3" countdown="$4" title
  title="$login"
  if [ "$show_flag" -eq 1 ] && [ "$active" = "yes" ]; then
    title="$title (active)"
  fi
  printf '%s── %s · %s UTC · resets in %s ────%s\n' \
    "$C_BOLD" "$title" "$BILL_YM" "$countdown" "$C_RESET"
}

print_unlock_hint() {
  printf '  ⚠ missing user scope — unlock: gh auth switch --user %s && gh auth refresh -h github.com -s user,codespace\n' "$1"
}

print_panel() {
  local login="$1" active="$2" show_flag="$3"
  local scopes usage totals compute storage hours gbm cpct spct label color rem2 rem4
  scopes=$(account_scopes "$login")
  print_panel_head "$login" "$active" "$show_flag" "$(reset_countdown "$(date -u +%s)" "$BILL_YEAR" "$BILL_MONTH")"

  if ! has_scope "$scopes" user; then
    print_unlock_hint "$login"
    return 0
  fi

  if usage=$(fetch_usage "$login"); then
    totals=$(summarize_usage "$usage")
    compute="${totals%% *}"
    storage="${totals##* }"
    hours=$(month_hours "$BILL_YEAR" "$BILL_MONTH")
    gbm=$(fdiv "$storage" "$hours")
    cpct=$(pct "$compute" "$COMPUTE_LIMIT")
    spct=$(pct "$gbm" "$STORAGE_LIMIT")
    color=$(color_code "$(color_for "$cpct")")
    rem2=$(remaining_hours "$compute" "$COMPUTE_LIMIT" 2)
    rem4=$(remaining_hours "$compute" "$COMPUTE_LIMIT" 4)

    printf 'Compute  %s%s%s %3s%%   %s/%s core-hrs · %s%s2-core %sh · 4-core %sh left%s\n' \
      "$color" "$(bar "$cpct")" "$C_RESET" "$cpct" \
      "$(fmt2 "$compute")" "$COMPUTE_LIMIT" \
      "$color" "$C_BOLD" "$rem2" "$rem4" "$C_RESET"
    label="$spct"
    if [ "$spct" -eq 0 ] && fgt "$gbm" 0; then
      label="<1"
    fi
    printf 'Storage  %s%s%s %4s%%   %s/%s GB-month\n' \
      "$(color_code "$(color_for "$spct")")" "$(bar "$spct")" "$C_RESET" \
      "$label" "$(fmt2 "$gbm")" "$STORAGE_LIMIT"
  else
    printf '  ⚠ could not fetch usage (see error above)\n'
  fi
}

# ---------- 子命令 ----------

parse_account_flags() {
  # 設定 ACCOUNT / ALL，其餘參數留在 REST 陣列
  ACCOUNT=""
  ALL=0
  REST=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --account)
        if [ $# -lt 2 ]; then die "--account requires <login>"; fi
        ACCOUNT="$2"
        shift 2
        ;;
      --account=*)
        ACCOUNT="${1#*=}"
        shift
        ;;
      --all)
        ALL=1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        REST+=("$1")
        shift
        ;;
    esac
  done
}

cmd_quota() {
  local accounts acct first
  parse_account_flags "$@"
  if [ "${#REST[@]}" -gt 0 ]; then
    die "quota: unknown argument ${REST[0]} (try gh csm help)"
  fi
  validate_limits
  load_auth
  set_billing_period
  accounts=$(selected_accounts)
  if [ -z "$accounts" ]; then
    die "no signed-in account. Run: gh auth login"
  fi
  first=1
  # ponytail: 裸變數分詞——GitHub login 字元集 [a-zA-Z0-9-] 保證無空白；支援 GHES、含空白帳號名時須改陣列。
  for acct in $accounts; do
    if [ "$first" -eq 0 ]; then
      printf '\n'
    fi
    first=0
    print_panel "$acct" "$(account_is_active "$acct")" "$ALL"
  done
}

# 共用選單：輸入 fetch_codespaces 的 TSV，選定後設定 PICK_NAME / PICK_STATE。
# q 取消回 1；非數字或超界直接 die。
pick_codespace() {
  local cs="$1" verb="$2" i choice n s c l _
  PICK_NAME=""
  PICK_STATE=""
  i=1
  while IFS=$'\t' read -r n s c l _; do
    if [ -z "$n" ]; then
      continue
    fi
    printf '  %2d) %-38s %-10s %s-core  last used %s\n' "$i" "$n" "$s" "$c" "$(local_time "$l")"
    i=$((i + 1))
  done <<< "$cs"

  printf 'Select which codespace to %s (q to cancel): ' "$verb"
  read -r choice || die "no input"
  case "$choice" in
    q|Q) printf 'Cancelled\n' ; return 1 ;;
    ''|*[!0-9]*) die "enter a numeric index" ;;
  esac

  i=1
  while IFS=$'\t' read -r n s c l _; do
    if [ -z "$n" ]; then
      continue
    fi
    if [ "$i" -eq "$choice" ]; then
      PICK_NAME="$n"
      PICK_STATE="$s"
    fi
    i=$((i + 1))
  done <<< "$cs"
  if [ -z "$PICK_NAME" ]; then
    die "index $choice is out of range"
  fi
  return 0
}

cmd_stop() {
  local name login cs ans
  name=""
  parse_account_flags "$@"
  if [ "${#REST[@]}" -gt 0 ]; then
    case "${REST[0]}" in
      -c|--codespace)
        if [ "${#REST[@]}" -lt 2 ]; then die "-c requires <name>"; fi
        name="${REST[1]}"
        if [ "${#REST[@]}" -gt 2 ]; then die "stop accepts a single -c <name>"; fi
        ;;
      *) die "stop: unknown argument ${REST[0]} (try gh csm help)" ;;
    esac
  fi
  validate_limits
  load_auth
  login=$(resolve_login)
  require_scope "$login" codespace

  if [ -n "$name" ]; then
    printf 'Stopping %s (account %s)…\n' "$name" "$login"
    gh_as "$login" codespace stop -c "$name"
    return 0
  fi

  if [ ! -t 0 ]; then
    die "use -c <name> in non-interactive mode: gh csm stop -c <name>"
  fi
  if ! cs=$(fetch_codespaces "$login"); then
    die "could not read the codespace list for $login"
  fi
  if [ -z "$cs" ]; then
    die "account $login has no codespaces"
  fi
  if ! pick_codespace "$cs" stop; then
    return 0
  fi
  if [ "$PICK_STATE" = "Shutdown" ]; then
    die "$PICK_NAME is already Shutdown (to reclaim storage use: gh codespace delete -c $PICK_NAME)"
  fi

  printf 'Stop %s? [y/N] ' "$PICK_NAME"
  read -r ans || ans=""
  case "$ans" in
    y|Y|yes|YES) ;;
    *) printf 'Cancelled\n' ; return 0 ;;
  esac
  gh_as "$login" codespace stop -c "$PICK_NAME"
}

cmd_start() {
  local name snippet have_snippet login arg idx cs
  name=""
  snippet=""
  have_snippet=0
  parse_account_flags "$@"
  if [ "${#REST[@]}" -gt 0 ]; then
    case "${REST[0]}" in
      -c|--codespace)
        if [ "${#REST[@]}" -lt 2 ]; then die "-c requires <name>"; fi
        name="${REST[1]}"
        idx=2
        while [ "$idx" -lt "${#REST[@]}" ]; do
          arg="${REST[$idx]}"
          if [ -z "$snippet" ]; then
            snippet="$arg"
          else
            snippet="$snippet $arg"
          fi
          have_snippet=1
          idx=$((idx + 1))
        done
        ;;
      *) die "start: unknown argument ${REST[0]} (try gh csm help)" ;;
    esac
  fi
  validate_limits
  load_auth
  login=$(resolve_login)
  require_scope "$login" codespace

  if [ -z "$name" ]; then
    if [ ! -t 0 ]; then
      die "start requires -c <name> in non-interactive mode"
    fi
    if ! cs=$(fetch_codespaces "$login"); then
      die "could not read the codespace list for $login"
    fi
    if [ -z "$cs" ]; then
      die "account $login has no codespaces"
    fi
    if ! pick_codespace "$cs" start; then
      return 0
    fi
    name="$PICK_NAME"
    printf 'Command to run (Enter for interactive shell): '
    read -r snippet || snippet=""
    if [ -n "$snippet" ]; then
      have_snippet=1
    fi
  fi

  if [ "$have_snippet" -eq 1 ]; then
    printf 'Waking %s and running: %s\n' "$name" "$snippet"
    gh_as "$login" codespace ssh -c "$name" -- "$snippet"
  else
    printf 'Waking %s and entering shell…\n' "$name"
    gh_as "$login" codespace ssh -c "$name"
  fi
}

# ---------- selftest（零網路） ----------

ST_PASS=0
ST_FAIL=0

st_ok() {
  ST_PASS=$((ST_PASS + 1))
  printf '  ok   %s\n' "$1"
}

st_bad() {
  ST_FAIL=$((ST_FAIL + 1))
  printf '  FAIL %s (expected %s, got %s)\n' "$1" "$2" "$3"
}

st_eq() {
  if [ "$2" = "$3" ]; then st_ok "$1"; else st_bad "$1" "$2" "$3"; fi
}

st_near() {
  if fclose "$2" "$3" "$4"; then st_ok "$1"; else st_bad "$1" "$2" "$3"; fi
}

cmd_selftest() {
  local fixture totals compute storage hours gbm warn_out epoch_a epoch_b
  if [ $# -gt 0 ]; then
    die "selftest takes no arguments"
  fi
  printf 'gh-csm %s selftest (offline fixtures, bb9755 2026-10 real billing)\n' "$VERSION"

  # SKU 核數解析
  st_eq "sku_cores 2-core" "2" "$(sku_cores 'Codespaces compute 2-core')"
  st_eq "sku_cores 4-core" "4" "$(sku_cores 'Codespaces compute 4-core')"
  st_eq "sku_cores 16-core" "16" "$(sku_cores 'Codespaces compute 16-core')"
  st_eq "sku_cores 32-core" "32" "$(sku_cores 'Codespaces compute 32-core')"
  if sku_cores 'Codespaces premium compute 2-core' >/dev/null; then
    st_bad "sku_cores unknown SKU fails" "non-zero exit" "0"
  else
    st_ok "sku_cores unknown SKU fails"
  fi

  # 真實 fixture 聚合
  fixture='{"usageItems":[{"date":"2026-10-01T00:00:00Z","product":"codespaces","sku":"Codespaces storage","quantity":0.406576944,"unitType":"GigabyteHours","pricePerUnit":0.07,"grossAmount":0.028460376,"discountAmount":0.028460376,"netAmount":0.0,"repositoryName":"_w"},{"date":"2026-10-02T00:00:00Z","product":"codespaces","sku":"Codespaces storage","quantity":0.406576944,"unitType":"GigabyteHours","pricePerUnit":0.07,"grossAmount":0.028460376,"discountAmount":0.028460376,"netAmount":0.0,"repositoryName":"_w"},{"date":"2026-10-03T00:00:00Z","product":"codespaces","sku":"Codespaces storage","quantity":0.406576944,"unitType":"GigabyteHours","pricePerUnit":0.07,"grossAmount":0.028460376,"discountAmount":0.028460376,"netAmount":0.0,"repositoryName":"_w"},{"date":"2026-10-04T00:00:00Z","product":"codespaces","sku":"Codespaces storage","quantity":0.406576944,"unitType":"GigabyteHours","pricePerUnit":0.07,"grossAmount":0.028460376,"discountAmount":0.028460376,"netAmount":0.0,"repositoryName":"_w"},{"date":"2026-10-05T00:00:00Z","product":"codespaces","sku":"Codespaces storage","quantity":0.406576944,"unitType":"GigabyteHours","pricePerUnit":0.07,"grossAmount":0.028460376,"discountAmount":0.028460376,"netAmount":0.0,"repositoryName":"_w"},{"date":"2026-10-06T00:00:00Z","product":"codespaces","sku":"Codespaces storage","quantity":0.406576944,"unitType":"GigabyteHours","pricePerUnit":0.07,"grossAmount":0.028460376,"discountAmount":0.028460376,"netAmount":0.0,"repositoryName":"_w"},{"date":"2026-10-07T00:00:00Z","product":"codespaces","sku":"Codespaces compute 4-core","quantity":5.08799,"unitType":"Hours","pricePerUnit":0.36,"grossAmount":1.8316764,"discountAmount":1.8316764,"netAmount":0.0,"repositoryName":"_w"},{"date":"2026-10-07T00:00:00Z","product":"codespaces","sku":"Codespaces storage","quantity":0.406576944,"unitType":"GigabyteHours","pricePerUnit":0.07,"grossAmount":0.028460376,"discountAmount":0.028460376,"netAmount":0.0,"repositoryName":"_w"},{"date":"2026-10-08T00:00:00Z","product":"codespaces","sku":"Codespaces storage","quantity":0.406576944,"unitType":"GigabyteHours","pricePerUnit":0.07,"grossAmount":0.028460376,"discountAmount":0.028460376,"netAmount":0.0,"repositoryName":"_w"},{"date":"2026-10-09T00:00:00Z","product":"codespaces","sku":"Codespaces storage","quantity":0.406576944,"unitType":"GigabyteHours","pricePerUnit":0.07,"grossAmount":0.028460376,"discountAmount":0.028460376,"netAmount":0.0,"repositoryName":"_w"},{"date":"2026-10-10T00:00:00Z","product":"codespaces","sku":"Codespaces storage","quantity":0.406576944,"unitType":"GigabyteHours","pricePerUnit":0.07,"grossAmount":0.028460376,"discountAmount":0.028460376,"netAmount":0.0,"repositoryName":"_w"},{"date":"2026-10-11T00:00:00Z","product":"codespaces","sku":"Codespaces storage","quantity":0.406576944,"unitType":"GigabyteHours","pricePerUnit":0.07,"grossAmount":0.028460376,"discountAmount":0.028460376,"netAmount":0.0,"repositoryName":"_w"},{"date":"2026-10-12T00:00:00Z","product":"codespaces","sku":"Codespaces storage","quantity":0.406576944,"unitType":"GigabyteHours","pricePerUnit":0.07,"grossAmount":0.028460376,"discountAmount":0.028460376,"netAmount":0.0,"repositoryName":"_w"},{"date":"2026-10-12T03:00:00Z","product":"codespaces","sku":"Codespaces compute 4-core","quantity":4.01271,"unitType":"Hours","pricePerUnit":0.36,"grossAmount":1.4445756,"discountAmount":1.4445756,"netAmount":0.0,"repositoryName":"_w"},{"date":"2026-10-13T00:00:00Z","product":"codespaces","sku":"Codespaces storage","quantity":0.153216771,"unitType":"GigabyteHours","pricePerUnit":0.07,"grossAmount":0.01072517,"discountAmount":0.01072517,"netAmount":0.0,"repositoryName":"_w"},{"date":"2026-10-13T09:00:00Z","product":"codespaces","sku":"Codespaces compute 4-core","quantity":0.01095,"unitType":"Hours","pricePerUnit":0.36,"grossAmount":0.003942,"discountAmount":0.003942,"netAmount":0.0,"repositoryName":"_w"},{"date":"2026-10-29T19:00:00Z","product":"codespaces","sku":"Codespaces compute 2-core","quantity":2.87154,"unitType":"Hours","pricePerUnit":0.18,"grossAmount":0.5168772,"discountAmount":0.5168772,"netAmount":0.0,"repositoryName":"_w"},{"date":"2026-10-29T19:00:00Z","product":"codespaces","sku":"Codespaces storage","quantity":0.036744971,"unitType":"GigabyteHours","pricePerUnit":0.07,"grossAmount":0.002572144,"discountAmount":0.002572144,"netAmount":0.0,"repositoryName":"_w"},{"date":"2026-10-30T00:00:00Z","product":"codespaces","sku":"Codespaces storage","quantity":0.18404025,"unitType":"GigabyteHours","pricePerUnit":0.07,"grossAmount":0.012882801,"discountAmount":0.012882801,"netAmount":0.0,"repositoryName":"_w"},{"date":"2026-10-30T03:00:00Z","product":"codespaces","sku":"Codespaces compute 2-core","quantity":4.89491,"unitType":"Hours","pricePerUnit":0.18,"grossAmount":0.8810838,"discountAmount":0.8810838,"netAmount":0.0,"repositoryName":"_w"},{"date":"2026-10-31T00:00:00Z","product":"codespaces","sku":"Codespaces storage","quantity":0.144174426,"unitType":"GigabyteHours","pricePerUnit":0.07,"grossAmount":0.010092192,"discountAmount":0.010092192,"netAmount":0.0,"repositoryName":"_w"}]}'
  totals=$(summarize_usage "$fixture")
  compute="${totals%% *}"
  storage="${totals##* }"
  st_near "fixture compute = 51.98 core-hrs" "51.98" "$(fmt2 "$compute")" "0.01"
  st_near "fixture storage = 5.40 GB-h" "5.40" "$(fmt2 "$storage")" "0.01"

  # 未知 SKU 必須警告，且不靜默計入
  warn_out=$(summarize_usage '{"usageItems":[{"product":"codespaces","sku":"Codespaces compute 2-core","quantity":1},{"product":"codespaces","sku":"Codespaces mystery sku","quantity":99}]}' 2>&1 >/dev/null)
  case "$warn_out" in
    *"unknown SKU"*) st_ok "unknown SKU warns" ;;
    *) st_bad "unknown SKU warns" 'contains "unknown SKU"' "$warn_out" ;;
  esac
  totals=$(summarize_usage '{"usageItems":[{"product":"codespaces","sku":"Codespaces compute 2-core","quantity":1},{"product":"codespaces","sku":"Codespaces mystery sku","quantity":99}]}' 2>/dev/null)
  st_eq "unknown SKU not counted in compute" "2.00" "$(fmt2 "${totals%% *}")"

  # 月初 UTC 換月時 billing 會回空陣列，不能炸
  totals=$(summarize_usage '{"usageItems":[]}')
  st_eq "empty usageItems = 0 / 0" "0.00 0.00" "$(fmt2 "${totals%% *}") $(fmt2 "${totals##* }")"

  # 百分比與色階
  st_eq "51.98/120 = 43%" "43" "$(pct "$compute" 120)"
  st_eq "threshold 69 = green" "green" "$(color_for 69)"
  st_eq "threshold 70 = yellow" "yellow" "$(color_for 70)"
  st_eq "threshold 89 = yellow" "yellow" "$(color_for 89)"
  st_eq "threshold 90 = red" "red" "$(color_for 90)"

  # 當月 UTC 實際小時數（2026-10 = 744）
  st_eq "2026-10 has 744 hours" "744" "$(month_hours 2026 10)"
  st_eq "2026-02 has 672 hours" "672" "$(month_hours 2026 2)"
  st_eq "2024-02 has 696 hours" "696" "$(month_hours 2024 2)"

  # storage GB-month 換算（÷744，非固定 720）
  hours=$(month_hours 2026 10)
  gbm=$(fdiv "$storage" "$hours")
  st_near "5.397 GB-h / 744 = 0.0073 GB-month" "0.0073" "$(fmt4 "$gbm")" "0.0001"

  # 剩餘時數換算（整數、向下取整）
  st_eq "(120-51.98)/2 = 34h" "34" "$(remaining_hours "$compute" 120 2)"
  st_eq "(120-51.98)/4 = 17h" "17" "$(remaining_hours "$compute" 120 4)"
  st_eq "exhausted quota = 0h" "0" "$(remaining_hours 130 120 2)"

  # 離重置倒數（固定 now epoch，對特定計費月）
  st_eq "countdown for 2026-10 = 7d22h" "7d22h" "$(reset_countdown 1792807200 2026 10)"
  st_eq "countdown across new year (5h before 2027-01-01)" "5h" \
    "$(reset_countdown "$(epoch_from_iso '2026-12-31T19:00:00Z')" 2026 12)"
  st_eq "countdown under 1 hour = 42m" "42m" \
    "$(reset_countdown "$(epoch_from_iso '2026-10-31T23:18:00Z')" 2026 10)"

  # 時區轉換：offset 與 Z 必須指同一瞬間
  epoch_a=$(epoch_from_iso '2026-10-30T23:26:35+08:00')
  epoch_b=$(epoch_from_iso '2026-10-30T15:26:35Z')
  st_eq "RFC3339 offset equals UTC instant" "$epoch_b" "$epoch_a"

  # 進度條邊界
  local full empty i
  full=""
  empty=""
  i=0
  while [ "$i" -lt 20 ]; do
    full="${full}█"
    empty="${empty}░"
    i=$((i + 1))
  done
  st_eq "bar 0% all empty" "$empty" "$(bar 0)"
  st_eq "bar 100% all full" "$full" "$(bar 100)"

  printf '\nselftest: %d passed, %d failed\n' "$ST_PASS" "$ST_FAIL"
  if [ "$ST_FAIL" -gt 0 ]; then
    exit 1
  fi
}

# ---------- main ----------

main() {
  local cmd="${1:-}"
  case "$cmd" in
    ""|-h|--help|help)
      usage
      ;;
    --version|-v)
      printf 'gh-csm %s\n' "$VERSION"
      ;;
    quota)
      shift
      cmd_quota "$@"
      ;;
    stop)
      shift
      cmd_stop "$@"
      ;;
    start)
      shift
      cmd_start "$@"
      ;;
    selftest)
      shift
      cmd_selftest "$@"
      ;;
    *)
      printf 'gh-csm: unknown subcommand %s\n\n' "$cmd" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
